# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Optional local inference downloads and installers (large, machine-specific).
models/
*.gguf
OllamaSetup.exe

# Databases
*.db
*.sqlite3
# SQLite writes a rollback journal next to the file while it is running.
*.db-journal
*.db-wal
*.db-shm

# Env
.env
.env.local
.env.*
!.env.example
!backend/.env.example

# Tooling caches
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/
npm-debug.log*
*.tsbuildinfo

# Local data and build artefacts.
# These used to be listed one by one, which is why stray dumps kept landing in
# the repo. The rules below cover the whole class instead.
*.log
*.err
*.out
backend/api_report.txt
backend/exp.txt
backend/live_report.txt
backend/run[2-5].txt
backend/sb.txt
backend/short.txt
backend/syntax_report.txt
backend/testout.txt
frontend/buildclean.txt
frontend/playwright-report/
frontend/test-results/
backend/reports/
frontend/scripts/

# Local signal exports and runtime state can contain private research data.
exports/
backend/exports/
logs/
cache/

# OS
.DS_Store
Thumbs.db
