# Signal Radar runs entirely on your machine. Nothing here is required:
# copy this file to .env and run `docker compose up`. Every value below is a
# default that already works, so an empty .env behaves identically.

# ===== APP =====
APP_ENV=development
API_DEBUG=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== DATABASE =====
# Matches docker-compose: Postgres in Docker, reachable on localhost.
DATABASE_URL=postgresql+asyncpg://signal:signal@localhost:5432/signal_radar
# To run with no Docker at all, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./signal_radar.db

# ===== REDIS =====
# Empty uses the in-memory bus, which is enough for a single local process.
REDIS_URL=

# ===== IDENTITY =====
# There is no login. One local account is created on first request and used for
# everything, so radars and saved signals work with no sign-up. Change the email
# to relabel it. Set AUTH_DISABLED=false only if you put this behind a shared
# host, which turns token auth back on.
AUTH_DISABLED=true
LOCAL_USER_EMAIL=local@signalradar

# ===== SOURCES / COLLECTORS =====
# Low-resource defaults: modest concurrent requests, small batches, optional AI off.
HTTP_MAX_CONCURRENCY=4
COLLECTION_MAX_EVENTS_PER_SOURCE=25
AI_CLASSIFICATION_ENABLED=false
SOURCE_COOLDOWN_SECONDS=300
# All optional. The free public strategies run without any of these; a token
# just raises a rate limit or unlocks a richer strategy.
GITHUB_TOKEN=
HF_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalRadar/0.1 (by /u/signalradar)

# ===== COLLECTION =====
# A minute is the point: the product promises to catch things early.
COLLECT_INTERVAL_SECONDS=60
SNAPSHOT_INTERVAL_SECONDS=60
FETCH_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=SignalRadarBot/0.1 (+https://github.com/signal-radar)
# Countries covered before you create any radar, so a fresh install collects
# something real instead of nothing.
DEFAULT_COLLECT_COUNTRIES=["US","GB","KR","JP","DE","BR"]
# Cap on queries built from your tags and radars, per run.
MAX_COLLECT_KEYWORDS=8

# ===== DETECTION =====
DETECT_MIN_STRENGTH=35
DETECT_BREAKOUT_STRENGTH=70
DETECT_RISING_STRENGTH=45
DETECT_FADING_DROP_RATIO=0.6
# Hard freshness cutoff in hours, applied when a signal is first ingested.
# This is what stops evergreen search hits from entering the feed as fresh.
# Raise it if the feed feels too empty; 0 disables the filter entirely.
DETECT_MAX_AGE_HOURS=72
DETECT_DEDUP_WINDOW_MINUTES=60

# ===== RETENTION =====
# Freshness over history: an unsaved signal lives SIGNAL_TTL_HOURS and is then
# removed. A signal you saved is kept; if it is unsaved after expiry it goes on
# the next cleanup run.
SIGNAL_TTL_HOURS=24
SOURCE_EVENT_TTL_HOURS=48
DELIVERY_TTL_DAYS=30
# Cleanup deletes in bounded batches so it never locks the table.
CLEANUP_BATCH_SIZE=2000
CLEANUP_MAX_ROWS_PER_RUN=10000
CLEANUP_INTERVAL_MINUTES=60

# ===== WEB PUSH (VAPID) =====
# Leave empty to disable browser push. Generate a pair with:
#   cd backend && python -m tools.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_TOKEN_ENCRYPTION_KEY=
