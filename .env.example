# ===== APP =====
APP_ENV=development
API_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# ===== DATABASE =====
# Postgres in Docker:
DATABASE_URL=postgresql+asyncpg://signal:signal@db:5432/signal_radar
# Local (no Docker) — override:
# DATABASE_URL=postgresql+asyncpg://signal:signal@localhost:5432/signal_radar
# SQLite fallback for local run without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./signal_radar.db

# ===== REDIS =====
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://localhost:6379/0
# Leave empty to use in-memory bus (dev without Redis):
# REDIS_URL=

# ===== AUTH =====
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ===== SOURCES / COLLECTORS =====
# All optional. Without any token the free strategies already run.
GITHUB_TOKEN=
HF_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalRadar/0.1 (by /u/signalradar)
# Credential-gated adapters stay disabled until official credentials exist.
# They are detected automatically from the tokens above, so there is no
# ENABLE_* switch to set.

# ===== COLLECTION =====
COLLECT_INTERVAL_SECONDS=900
SNAPSHOT_INTERVAL_SECONDS=900
FETCH_TIMEOUT_SECONDS=30
HTTP_USER_AGENT=SignalRadarBot/0.1 (+https://github.com/signal-radar)

# ===== DETECTION (configurable, never hardcoded) =====
DETECT_MIN_STRENGTH=35
DETECT_BREAKOUT_STRENGTH=70
DETECT_RISING_STRENGTH=45
DETECT_FADING_DROP_RATIO=0.6
DETECT_MIN_AGE_MINUTES=0
DETECT_DEDUP_WINDOW_MINUTES=60

# ===== RETENTION =====
# Freshness over history: an unsaved signal lives SIGNAL_TTL_HOURS and is then
# removed. A signal the user saved is kept forever; if it is unsaved after
# expiry it disappears on the next cleanup run.
SIGNAL_TTL_HOURS=24
SOURCE_EVENT_TTL_HOURS=48
DELIVERY_TTL_DAYS=30
# Cleanup deletes in bounded batches so it never locks the table.
CLEANUP_BATCH_SIZE=2000
CLEANUP_MAX_ROWS_PER_RUN=10000
CLEANUP_INTERVAL_MINUTES=60

# ===== WEB PUSH (VAPID) =====
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=