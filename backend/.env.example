# Backend settings for running without Docker, via `python -m app.workers.schedule`.
# The Docker stack injects its own environment and ignores this file.
#
# Copy to .env if you want to change anything. Every value here is already the
# default, so the app runs with no .env at all.

APP_ENV=development
API_DEBUG=true
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# SQLite needs no server, so the collector runs with nothing else installed.
# To use the Postgres from docker compose instead:
# DATABASE_URL=postgresql+asyncpg://signal:signal@localhost:5432/signal_radar
DATABASE_URL=sqlite+aiosqlite:///./signal_radar.db

# In-process event bus; nothing external is required for a single local worker.
REDIS_URL=

# There is no login. One local account is created on first request.
AUTH_DISABLED=true
LOCAL_USER_EMAIL=local@signalradar

# All optional. The free public strategies run without any of these.
GITHUB_TOKEN=
HF_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SignalRadar/0.1 (by /u/signalradar)

COLLECT_INTERVAL_SECONDS=60
SNAPSHOT_INTERVAL_SECONDS=60
FETCH_TIMEOUT_SECONDS=30
DEFAULT_COLLECT_COUNTRIES=["US","GB","KR","JP","DE","BR"]
MAX_COLLECT_KEYWORDS=8

DETECT_MIN_STRENGTH=35
DETECT_BREAKOUT_STRENGTH=70
DETECT_RISING_STRENGTH=45
DETECT_FADING_DROP_RATIO=0.6
# Hard freshness cutoff in hours, applied at ingestion. This is what stops
# evergreen search hits from entering the feed as fresh. 0 disables it.
DETECT_MAX_AGE_HOURS=72
DETECT_DEDUP_WINDOW_MINUTES=60

SIGNAL_TTL_HOURS=24
SOURCE_EVENT_TTL_HOURS=48

# Leave empty to disable browser push. Generate with: python -m tools.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

TELEGRAM_BOT_TOKEN=